# Explicitly export these settings; the worker does not automatically load this file.
NEXUSFLOW_ENVIRONMENT=local
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=validation-tq
TEMPORAL_TLS=false
NEXUSFLOW_SHUTDOWN_GRACE_SECONDS=30
NEXUSFLOW_PROBE_HOST=127.0.0.1
NEXUSFLOW_PROBE_PORT=8081
