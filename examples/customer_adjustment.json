{
  "process_id": "LW-1001",
  "workflow_name": "customer-adjustment",
  "request": {
    "customer_id": "C-100045",
    "amount": 7500,
    "reason": "fee correction",
    "simulate_transient_failure": true
  },
  "variables": {
    "requested_by": "demo.user"
  },
  "start_at": "validate",
  "steps": {
    "validate": {
      "type": "activity",
      "capability": "validate_request",
      "timeout_seconds": 10,
      "next": "risk"
    },
    "risk": {
      "type": "activity",
      "capability": "risk_check",
      "timeout_seconds": 10,
      "retry": {
        "maximum_attempts": 3,
        "initial_interval_seconds": 1,
        "backoff_coefficient": 2
      },
      "next": "route"
    },
    "route": {
      "type": "decision",
      "field": "results.risk.risk_score",
      "operator": "<=",
      "value": 50,
      "on_true": "post",
      "on_false": "manager_approval"
    },
    "manager_approval": {
      "type": "approval",
      "assignee_group": "operations-managers",
      "timeout_seconds": 300,
      "on_approved": "post",
      "on_rejected": "record_rejection",
      "on_timeout": "timed_out"
    },
    "post": {
      "type": "activity",
      "capability": "post_adjustment",
      "timeout_seconds": 10,
      "next": "notify"
    },
    "notify": {
      "type": "activity",
      "capability": "send_notification",
      "input": {
        "channel": "email"
      },
      "next": "completed"
    },
    "record_rejection": {
      "type": "activity",
      "capability": "record_rejection",
      "next": "rejected"
    },
    "completed": {
      "type": "end",
      "outcome": "COMPLETED"
    },
    "rejected": {
      "type": "end",
      "outcome": "REJECTED"
    },
    "timed_out": {
      "type": "end",
      "outcome": "TIMED_OUT"
    }
  }
}
