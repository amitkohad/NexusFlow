# Governed API/runtime local defaults. Environment files are not auto-loaded.
# Each capability worker has its own .env.example with its owned queue.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_TASK_QUEUE=workflow-orchestration-tq
NEXUSFLOW_RUNTIME_PROFILE=governed

# Workflow API: explicit environment loading, no automatic .env loading.
NEXUSFLOW_ENVIRONMENT=local
NEXUSFLOW_DATABASE_URL=sqlite:///nexusflow.db
TEMPORAL_NAMESPACE=default
TEMPORAL_TLS=false
NEXUSFLOW_API_ACTOR=local-developer
NEXUSFLOW_API_TENANT=demo
NEXUSFLOW_API_DOMAIN=customer-services
NEXUSFLOW_API_APPLICATION=adjustments
# Set NEXUSFLOW_API_TOKEN locally to a generated token (32+ characters).
# Leaving it unset makes the API deny business operations.
NEXUSFLOW_MAX_PAYLOAD_BYTES=1048576
NEXUSFLOW_MAX_DEFINITION_STEPS=500
# app.worker is the legacy demo; run it separately with
# TEMPORAL_TASK_QUEUE=lightweight-workflows and use API profile legacy if needed.
