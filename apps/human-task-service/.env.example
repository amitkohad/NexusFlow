# The same credential is configured on the package Activity adapter for local use.
# Generate a unique 32+ character development token; never use this adapter in production.
NEXUSFLOW_ENVIRONMENT=local
NEXUSFLOW_DATABASE_URL=sqlite:///nexusflow.db
NEXUSFLOW_HUMAN_TASK_SERVICE_TOKEN=replace-with-a-unique-development-token-at-least-32-chars
NEXUSFLOW_HUMAN_TASK_ACTOR_TOKEN=replace-with-a-different-human-actor-token-at-least-32-chars
NEXUSFLOW_HUMAN_TASK_ACTOR=local-task-operator
NEXUSFLOW_HUMAN_TASK_TENANT=demo
NEXUSFLOW_HUMAN_TASK_DOMAIN=customer-services
NEXUSFLOW_HUMAN_TASK_APPLICATION=adjustments
NEXUSFLOW_HUMAN_TASK_GROUPS=approvers
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
