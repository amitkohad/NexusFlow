TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TLS=false
NEXUSFLOW_ENVIRONMENT=local
NEXUSFLOW_PROBE_HOST=127.0.0.1
NEXUSFLOW_PROBE_PORT=8090
# Generated if absent; use a unique value for each process/pod.
# NEXUSFLOW_EXECUTOR_INSTANCE_ID=local-1
NEXUSFLOW_WORKFLOW_TASK_SLOTS=100
NEXUSFLOW_ACTIVITY_TASK_SLOTS=100
NEXUSFLOW_WORKFLOW_TASK_POLLERS=5
NEXUSFLOW_ACTIVITY_TASK_POLLERS=5
NEXUSFLOW_SHUTDOWN_GRACE_SECONDS=30
# Positive finite optional rate limits; otherwise SDK has no configured rate cap.
# NEXUSFLOW_MAX_ACTIVITIES_PER_SECOND=100
# NEXUSFLOW_MAX_TASK_QUEUE_ACTIVITIES_PER_SECOND=200
